# ===================================================================
# 环境变量模板
# 复制为 .env 后填写；Cloudflare 请用 wrangler secret 注入，Docker/Node 用环境变量
# ===================================================================

# ------------------------------------------------------------------
# Trakt 应用凭据
#
# 前往 https://app.trakt.tv/settings/apps/api 新建应用：
#   Name:         Trakt 播出提醒
#   Redirect URI: urn:ietf:wg:oauth:2.0:oob      ← Device Flow 用这个占位
#   Permissions:  Read（读取日历与观看进度即可，无需写权限）
#
# 为什么用 Device Code Flow：Authorization Code Flow 要求 redirect_uri
# 与注册值完全一致（大小写敏感），自托管换域名就得重新注册应用。
# Device Flow 不依赖回调，一套凭据可部署到任意域名。
# （Trakt 现在推荐 PKCE，但 PKCE 只适用于 Authorization Code Flow ——
#  它要的 redirect_uri 恰是本项目为了"任意域名部署"而放弃的东西。）
#
# ⚠️ 只需要 Client ID —— 本项目**不支持 client_secret**，也没有这个配置项。
#    Trakt 已废弃它用于用户登录（"future apps may not receive a Client Secret
#    at all"），设备码流程的参数表里也已经没有它了。新建应用时表单可能不给
#    secret，那是正常的，不用去找。见 src/trakt/oauth.ts 的说明。
# ------------------------------------------------------------------
TRAKT_CLIENT_ID=

# Trakt API 根地址，留空即官方 https://api.trakt.tv
# 只在本地开发/离线验证时改它 —— 配合 scripts/fake-trakt.mjs
# 可以在没有 Trakt 账号的情况下把整条链路跑起来。
TRAKT_API_BASE=

# ------------------------------------------------------------------
# TMDB API Key —— **可选**，用于片名中文兜底
#
# 为什么需要：Trakt 的 /v3/intl/bulk（站内接口，能一次问 100 条）
# 对新剧、冷门剧常常**没有中文条目**，于是中文界面上会出现一片英文原名。
# 配上这个值之后，Trakt 没译名的条目会再去 TMDB 查一次译名；
# 不配就只留英文原名（功能正常，只是片名不本地化）。
#
# 获取：https://www.themoviedb.org/settings/api → "API Key"（v3 auth）
# ⚠️ 不要填 "API Read Access Token" —— 那是 v4 的 Bearer 方式，对这里会 401。
#
# ⚠️ 密钥只从环境变量读，代码里没有任何硬编码，也不要提交 .env。
#    请到 https://www.themoviedb.org/settings/api 里把你部署所用的服务器 IP
#    加进 "API Key 的允许来源"，否则可能被 TMDB 拒掉。
# ------------------------------------------------------------------
TMDB_API_KEY=

# TMDB API 根地址，留空即官方 https://api.themoviedb.org/3
# 仅本地开发/离线验证时改它（配合 scripts/fake-tmdb.mjs）
TMDB_API_BASE=

# ------------------------------------------------------------------
# 加密与签名（首次部署时生成，务必妥善保存）
#   openssl rand -base64 32   → ENCRYPTION_KEY
#   openssl rand -hex 32      → CRON_SECRET / ADMIN_SECRET / SESSION_SECRET
#
# 也可以直接跑 `npm run secrets` 一次性生成四个。
#
# ENCRYPTION_KEY 用于加密落库的 trakt token 与渠道密钥。
# ⚠️ 一旦更换，所有已加密数据都解不开，用户需要重新授权。
#
# 为什么不把 CRON_SECRET 和 ADMIN_SECRET 合成一个：
#   CRON_SECRET 必须粘贴到外部调度器（cron-job.org / QStash / 平台 Cron）
#   的后台，会出现在对方的数据库、访问日志和你的浏览器历史里。
#   如果它同时是管理员凭据，那这些地方任何一处泄漏都等于交出实例控制权。
# ------------------------------------------------------------------
ENCRYPTION_KEY=
CRON_SECRET=
ADMIN_SECRET=
SESSION_SECRET=

# ------------------------------------------------------------------
# 管理页口令（ADMIN_SECRET）—— 认领实例 / 登录管理后台时填入
#
# 设备码授权端点无法要求登录（否则首次部署永远进不去），
# 而单用户模式下换一个 Trakt 账号登录会**改绑**已有的用户行。
# 两者叠加就意味着"能访问到这个地址"= "能夺走这个实例"。
# 所以设备码流程要求先出示这个口令。
#
# ⚠️ 多用户部署下它不是"注册准入"，而是**管理后台的口令**
#    （/api/admin/*，见下面 ALLOW_MULTI_USER 一段）。
#
# ⚠️ 必填，且必须与 CRON_SECRET 不同 —— 缺失或与它相同都会被判为非法配置、拒绝启动。
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# 多用户部署
#
# ALLOW_MULTI_USER=true 时，同一份部署服务多个人：
#   · 每个人用自己的 Trakt 账号在首页登录，数据按 user_id 隔离
#   · 管理员是**独立身份** —— 用 ADMIN_SECRET 打开 /#/admin，
#     不绑定任何 Trakt 账号，只管理用户与实例设置，看不到别人的数据
#   · 设备码端点不再要求管理页口令（普通用户不可能持有它），
#     改由下面的 REGISTRATION_SECRET 控制准入
#
# 单用户部署（默认 false）：一份部署属于一个人，认领实例要管理页口令。
# ------------------------------------------------------------------
ALLOW_MULTI_USER=false

# ------------------------------------------------------------------
# 注册口令 —— **留空表示开放注册**
#
# 所有用户共用同一套 Trakt 应用凭据，而 Trakt 的限流按 client 算
# （约 1000 请求 / 5 分钟）。完全开放的注册意味着任何知道地址的人
# 都能开账号，进而挤占所有人的通知配额。
#
# 配了就要求注册时出示（首页会出现一个输入框）；自己用就留空。
# 注意它只是**准入**，不是身份 —— 已有账号的人不受它影响，
# 关掉注册也照样能重新登录（否则已有账号 token 一过期就回不来了）。
# ------------------------------------------------------------------
REGISTRATION_SECRET=

# ------------------------------------------------------------------
# 数据库
#   libsql  → 本地 SQLite 文件（自托管 / Docker）
#   d1      → Cloudflare D1（仅 Workers，走 binding 不需要 DATABASE_URL）
#
# 目前只支持 SQLite 方言：两种部署目标（D1 / 本地文件）背后都是 SQLite，
# 没有方言差异需要抹平，所以刻意不引 ORM。
# ------------------------------------------------------------------
DB_DRIVER=libsql
DATABASE_URL=file:./data/trakt.db
# 自托管 / Docker 使用 file: 路径，数据文件放在持久卷里。

# ------------------------------------------------------------------
# 部署地址（用于生成 Trakt 跳转链接、图标，以及**CORS 的来源白名单**）
#
# BASE_URL 自己的 origin 是唯一默认放行的跨源来源。
# 反过来说：改了 BASE_URL 而没同步 CORS，前端就调不通接口。
# ------------------------------------------------------------------
BASE_URL=http://localhost:3000

# ------------------------------------------------------------------
# 可选：额外的跨源来源（逗号分隔，写完整 origin）
#
# 只有真的要把管理接口嵌到别的站点时才需要。**不要写 `*`** ——
# 这套接口带凭据（会话 cookie + x-admin-secret），放开来源
# 等于把规则、渠道配置和观看历史交给任何页面。
# ------------------------------------------------------------------
ALLOWED_ORIGINS=

# ------------------------------------------------------------------
# 调度
#   内置调度（Docker / Node 部署）：true
#   平台/外部调度（CF Cron / cron-job.org）：false
# ------------------------------------------------------------------
ENABLE_INTERNAL_CRON=true
INTERNAL_CRON_EXPRESSION=*/1 * * * *

# 回看窗口：调度漏跑时最多补发多久之前的通知（分钟）
# 外部调度器延迟较大的场景靠这个兜底
TICK_LOOKBACK_MINUTES=2880

# 计划重算间隔（分钟）。调度拆成两段：派发每分钟跑（只查库，不碰 Trakt），
# 重算按这个间隔跑（拉 Trakt、跑规则引擎、把未来 30 天的计划落库）。
# 所以「每分钟的 tick」正常情况下一次 Trakt 都不请求。
PLAN_REFRESH_MINUTES=15

# ------------------------------------------------------------------
# 可选：运行参数
# ------------------------------------------------------------------
DEFAULT_TIMEZONE=Asia/Shanghai
# 单次 tick 处理的用户批大小。
#
# ⚠️ 默认 5 是**按最受限的平台定的**：一轮 tick 就是一个 invocation，而
#    Cloudflare Workers 免费版对单次调用的 subrequest 有硬上限（fetch 类 50 次、
#    D1/KV 等内部服务 1000 次）。每个用户一轮要打 1~5 个 Trakt 端点 + 十几次 D1，
#    批量一大就会整轮失败（表现为调度"跑了但什么都没发"）。
#    Docker / Node 自托管、或 Workers 付费版没有这个限制，可以放心调大。
TICK_BATCH_SIZE=5
# 渠道发送并发上限，避免被推送服务限流
CHANNEL_CONCURRENCY=5
